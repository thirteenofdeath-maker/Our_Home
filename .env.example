# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings -> API). Never commit .env.local.

# Public — safe to expose to the browser (used by the anon/public client).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
